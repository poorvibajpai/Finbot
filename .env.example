# Copy this file to .env (and load it, e.g. with `python-dotenv` or your shell)
# before running the app, or just export these variables directly.

# "ollama" (default, local & free) or "gemini"
LLM_PROVIDER=ollama

# --- Ollama settings (used when LLM_PROVIDER=ollama) ---
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.1

# --- Gemini settings (used when LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Flask session signing key — set to any random string for real use
FLASK_SECRET_KEY=dev-secret-change-me
